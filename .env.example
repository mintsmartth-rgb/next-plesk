# Option A: use a single connection string.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE"

# Option B: use individual PostgreSQL settings if DATABASE_URL is not set.
PGHOST="localhost"
PGPORT="5432"
PGDATABASE="database_name"
PGUSER="database_user"
PGPASSWORD="database_password"

# Set to require if your database requires SSL.
# Common values: disable, prefer, require
PGSSLMODE="disable"
